MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1942517049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61e8d79f38f431348a44b9fd90e5250d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UINavigationManager
  flow: {fileID: 485977911}
  gameManager: {fileID: 1196935695}
  playerController: {fileID: 2111572959}
  topBar: {fileID: 591536214}
  helpPanel: {fileID: 904525128}
  confirmBackPanel: {fileID: 134477995}
  helpBodyText: {fileID: 1567540645}
  helpDefault: 'Use Pause to stop safely.

    Use Back to return to hub.

    Use
    Help anytime for current task instructions.'
  helpSimulation1: "Simulation 1 - Emergency preparedness\n\n1) Enter the home and
    collect 5 items (press E):\n   \u2022 Water bottle\n   \u2022 Flash light\n  
    \u2022 Radio\n   \u2022 Phone\n   \u2022 Key\n\n2) Turn off the lights (press
    E)\n3) Close the entrance door (press E)\n4) Run to the Mamad (shelter) outside"
  helpSimulation2: "Simulation 2 - First Aid Under Pressure\n\n1) Collect the first
    aid kit (press E)\r\n2) Find the wounded person and press E\r\n3) At the public
    telephone:\r\n    E open the door \u2192 E insert coin \u2192 E lift the phone
    \u2192 \n    dial 1, 0, 1\r\n4) Return to the wounded person:\r\n    Press E
    to start treatment, then press 1, then 2, then 3"
  helpEnvironmentLearning: "Environment Learning Tour\n\nExplore the scene and learn
    where important items are located.\r\nHow to use:\r\n\u2022 Walk freely with
    W and look with the mouse.\r\n\u2022 Name tags appear above key items in the
    world.\r\n\u2022 Use the left sidebar and click an item name to go there.\n\u2022
    Take your time to look around and remember each location.\n\u2022 Press Back
    or Esc when finished to return to simulation selection.\r\n\r\nSimulation 1:\r\nHome,
    Water Bottle, Flashlight, Radio, Phone, Key, Light Switch,\nEntrance Door, Mamad\n\r\nSimulation
    2:\r\nFirst Aid, Wounded Character, Public Phone"
  pauseKey: 27
  helpKey: 104
