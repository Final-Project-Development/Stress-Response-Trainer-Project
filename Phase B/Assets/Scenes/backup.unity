  hubTitle: VR Stress Response Trainer
  applyHubTitleFromController: 0
  hubConnectionStatusDemo: 'Smartwatch: Not connected (simulated HR/HRV)

    Android
    gateway: Not in use'
  introNarrationText: "In recent years, many of us have experienced stress and pressure\ndue
    to emergency situations and war.\n\nThis training experience is designed to help
    improve your ability to function under stress.\n\nPlease connect your watch.
    \n\nIn each simulation, your physiological response is measured and at the end
    you receive practical recommendations for next time."
  introParagraph1: "In recent years, many of us have experienced stress and \npressure
    due to emergency situations and war."
  introParagraph2: "This training experience is designed to help improve your \nability
    to function under stress."
  introParagraph3: Please connect your watch.
  introParagraph4: 'In each simulation, your physiological response is measured and
    at

    the end you receive practical recommendations for next time.'
  introParagraph1Start: 0
  introParagraph2Start: 6
  introParagraph3Start: 10.5
  introParagraph4Start: 13
  calibrationInstruction: "Stand still and relax for 60s.\nWe are calibrating your
    \nheart-rate metrics."
  missionBriefingBody: 'Simulation 1: Emergency Preparedness


    Collect 5 essential
    supplies inside the house.






    Turn off lights, close the door, and enter
    the Mamad shelter.'
  learnBriefingBody: "Environment Learning - City tour\n\nExplore important locations
    and objects in the \ntraining environment.\n\nUse the left sidebar to jump to
    each item and read the \nlabels in the world.\n\nMovement controls:\r\nW - Move
    forward\r\nA / D - Strafe left / right\r\nS - Move backward\r\nMouse - Look around\n\nWhen
    you are ready, press Start learn."
  sim2BriefingBody: "Simulation 2 - First Aid Under Pressure\n\n1) Collect the first
    aid kit\n2) Find the wounded person\n3) Go to the public telephone:\n    Open
    the door \u2192 \n    Insert coin \u2192 \n    Lift the phone \u2192 \n    Dial
    1, 0, 1\n4) Return to the wounded person:\n    Start treatment, then press 1,
    then 2, then 3"
  sim1AllItemsCollectedCompleted: All supplies collected.
  sim1LightsOffCompleted: Lights turned off.
  sim1DoorClosedCompleted: Door closed.
  sim1ShelterDoorOpenHint: "The entrance door is still open. \nClose the door before
    entering the Mamad."
  sim1ObjectiveTurnOffLights: Turn off the lights using inside the home.
  sim1ObjectiveTurnOffLightsApproach: Turn off the lights using the light switch
    inside the home.
  sim1ObjectiveTurnOffLightsAction: Press E on the light switch to turn off the lights.
  sim1ObjectiveCloseDoor: Close the entrance door before leaving.
  sim1ObjectiveCloseDoorApproach: Close the entrance door before going to the Mamad
    shelter.
  sim1ObjectiveCloseDoorAction: Press E to close the entrance door.
  sim1ObjectiveRunToShelter: Run to the Mamad (shelter) outside.
  sim1ObjectiveRunToShelterApproach: Run to the Mamad shelter outside.
  sim1ObjectiveRunToShelterAction: Enter the Mamad shelter.
  sim2ObjectiveFindKit: Search the city for the first aid kit.
  sim2ObjectiveFindKitApproach: Find the first aid kit in the city.
  sim2ObjectiveFindKitAction: Press E to collect the first aid kit.
  sim2ObjectiveFindWounded: Find the wounded person in the city and press E.
  sim2ObjectiveFindWoundedApproach: Find the wounded person in the city.
  sim2ObjectiveFindWoundedAction: Press E on the wounded person.
  sim2CasualtyContactedCompleted: Wounded person found.
  sim2ObjectiveGoToPhone: Go to the public telephone and open the door.
  sim2ObjectiveGoToPhoneApproach: Go to the public telephone.
  sim2ObjectiveDialPhoneApproach: Go to the telephone and dial 1, 0, 1 on the keypad.
  sim2EmergencyReportedCompleted: Emergency call placed.
  sim2PhoneOpenDoorHint: Press E on the booth door to open it.
  sim2PhoneDoorOpenedCompleted: Door opened.
  sim2PhoneDoorOpenedObjective: Press E on the coin slot.
  sim2PhoneCoinInsertedCompleted: Coin inserted.
  sim2PhoneCoinInsertedObjective: Press E on the receiver.
  sim2PhoneDoorAlreadyOpenHint: "The door is already open. \nPress E on the coin
    slot."
  sim2PhoneInsertCoinHint: Press E on the coin slot to insert a coin.
  sim2PhoneReceiverLiftedCompleted: Phone lifted.
  sim2TreatmentStartedCompleted: Treatment started.
  sim2TreatmentCompleteCompleted: 'Treatment complete: 1, 2, 3.'
  sim2NeedContactCasualtyBeforePhoneHint: Find the wounded person first and press
    E.
  sim2AlreadyReportedHint: ' Find the wounded person.'
  sim2TreatWoundedHint: "Find the wounded person in the city. \nPress E to start
    treatment, then keys 1 \u2192 2 \u2192 3."
  sim2TreatWoundedApproach: Return to the wounded person for treatment.
  sim2TreatWoundedPressEAction: Press E on the wounded person to start treatment.
  sim2TreatWoundedPress1Action: Press 1.
  sim2TreatWoundedPress2Action: Press 2.
  sim2TreatWoundedPress3Action: Press 3.
  sim2CompletedHint: "First aid complete. \nSimulation 2 mission finished."
  sim2NeedKitHint: Find the first aid kit in the city before treating the wounded.
  calibrationDurationSeconds: 7
  runSimulation2InSameScene: 1
  simulation2SceneIndex: 1
